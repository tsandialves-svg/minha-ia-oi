# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA compartilhe o arquivo .env com ninguém nem suba ele pro GitHub.

# Porta em que o servidor vai rodar
PORT=3000

# Chave da API do Google Gemini
# Como conseguir: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo do Gemini a ser usado
GEMINI_MODEL=gemini-2.5-flash

# Chave secreta para gerar tokens de login (invente uma senha longa e aleatória)
JWT_SECRET=troque_isso_por_uma_frase_secreta_bem_longa_e_aleatoria

# Credenciais do Mercado Pago
# Como conseguir: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=coloque_seu_access_token_aqui

# URL pública do seu site depois de publicado (usada nos links de retorno do pagamento)
PUBLIC_URL=http://localhost:3000
